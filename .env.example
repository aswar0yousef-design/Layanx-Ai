## LayanX AI runtime mode: local | cloud | hybrid
LAYANX_AI_MODE=local

# Ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/responses
OPENAI_HEALTH_URL=https://api.openai.com/v1/models
OPENAI_MODEL=gpt-5.6-luna
# Voice (OpenAI audio endpoints; optional until an API key is configured)
OPENAI_AUDIO_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Anthropic Claude
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_HEALTH_URL=https://api.anthropic.com/v1/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_HEALTH_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.6-flash

# Local Runtime API
LAYANX_API_HOST=127.0.0.1
LAYANX_API_PORT=3000
LAYANX_API_TOKEN=

# Optional GitHub read connector token (never commit the actual token)
GITHUB_TOKEN=

# Business Operations (local secrets only; never commit real values)
LAYANX_BUSINESS_STORAGE_PATH=.layanx/business.json
LAYANX_MEDIA_STORAGE_PATH=.layanx/media.json
# Optional encrypted local credential vault. Keep the master key outside Git and outside .env.example.
LAYANX_SECRET_VAULT_PATH=.layanx/secrets.vault
LAYANX_SECRET_VAULT_KEY=
LAYANX_COMMERCE_TOKEN=
LAYANX_SHOPIFY_ACCESS_TOKEN=
LAYANX_WOOCOMMERCE_CONSUMER_KEY=
LAYANX_WOOCOMMERCE_CONSUMER_SECRET=
LAYANX_SOCIAL_TOKEN=
LAYANX_SOCIAL_PUBLISH_URL=

# Paid advertising (local secrets only; never commit real values)
# Meta / Facebook + Instagram Ads
LAYANX_META_ADS_BASE_URL=
LAYANX_META_ADS_TOKEN=
LAYANX_META_ADS_PATH_PREFIX=
# TikTok Ads
LAYANX_TIKTOK_ADS_BASE_URL=
LAYANX_TIKTOK_ADS_TOKEN=
LAYANX_TIKTOK_ADS_PATH_PREFIX=
# Google Ads REST
LAYANX_GOOGLE_ADS_BASE_URL=https://googleads.googleapis.com
LAYANX_GOOGLE_ADS_TOKEN=
LAYANX_GOOGLE_ADS_PATH_PREFIX=
# X Ads
LAYANX_X_ADS_BASE_URL=
LAYANX_X_ADS_TOKEN=
LAYANX_X_ADS_PATH_PREFIX=

# Optional per-operation paths override the shared PATH_PREFIX (use the official platform API paths).
# Example operation keys: CAMPAIGN_CREATE_PATH, CAMPAIGN_UPDATE_PATH, CAMPAIGN_PAUSE_PATH,
# AD_GROUP_CREATE_PATH, AD_CREATE_PATH, INSIGHTS_PATH.
# LAYANX_META_ADS_CAMPAIGN_CREATE_PATH=
# LAYANX_META_ADS_HEADERS_JSON={"Some-Platform-Header":"value"}
# LAYANX_TIKTOK_ADS_HEADERS_JSON=
# LAYANX_GOOGLE_ADS_HEADERS_JSON={"developer-token":"...","login-customer-id":"..."}
# LAYANX_X_ADS_HEADERS_JSON=
# LAYANX_LINKEDIN_ADS_HEADERS_JSON={"Linkedin-Version":"202601"}
# LAYANX_SNAPCHAT_ADS_HEADERS_JSON=
# LAYANX_PINTEREST_ADS_HEADERS_JSON=
# LAYANX_REDDIT_ADS_HEADERS_JSON=

# Platform-specific organic social publishing endpoints/tokens (keep real secrets local)
LAYANX_INSTAGRAM_SOCIAL_PUBLISH_URL=
LAYANX_INSTAGRAM_SOCIAL_TOKEN=
LAYANX_FACEBOOK_SOCIAL_PUBLISH_URL=
LAYANX_FACEBOOK_SOCIAL_TOKEN=
LAYANX_TIKTOK_SOCIAL_PUBLISH_URL=
LAYANX_TIKTOK_SOCIAL_TOKEN=
LAYANX_YOUTUBE_SOCIAL_PUBLISH_URL=
LAYANX_YOUTUBE_SOCIAL_TOKEN=
LAYANX_X_SOCIAL_PUBLISH_URL=
LAYANX_X_SOCIAL_TOKEN=
LAYANX_LINKEDIN_SOCIAL_PUBLISH_URL=
LAYANX_LINKEDIN_SOCIAL_TOKEN=
LAYANX_SNAPCHAT_SOCIAL_PUBLISH_URL=
LAYANX_SNAPCHAT_SOCIAL_TOKEN=
LAYANX_PINTEREST_SOCIAL_PUBLISH_URL=
LAYANX_PINTEREST_SOCIAL_TOKEN=

# OAuth connection center (provider client IDs may be public; client secrets are read locally into the encrypted vault)
LAYANX_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/v1/oauth/callback
LAYANX_TIKTOK_OAUTH_CLIENT_ID=
LAYANX_TIKTOK_OAUTH_CLIENT_SECRET=
LAYANX_TIKTOK_OAUTH_REDIRECT_URI=
LAYANX_TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish
LAYANX_GOOGLE_OAUTH_CLIENT_ID=
LAYANX_GOOGLE_OAUTH_CLIENT_SECRET=
LAYANX_GOOGLE_OAUTH_REDIRECT_URI=
LAYANX_GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/adwords
LAYANX_LINKEDIN_OAUTH_CLIENT_ID=
LAYANX_LINKEDIN_OAUTH_CLIENT_SECRET=
LAYANX_LINKEDIN_OAUTH_REDIRECT_URI=
LAYANX_LINKEDIN_OAUTH_SCOPES=openid,profile,w_member_social


# Native social adapters (used automatically when no *_SOCIAL_PUBLISH_URL is configured and an OAuth token exists)
LAYANX_INSTAGRAM_SOCIAL_BASE_URL=https://graph.facebook.com
LAYANX_FACEBOOK_SOCIAL_BASE_URL=https://graph.facebook.com
LAYANX_META_GRAPH_VERSION=
LAYANX_TIKTOK_SOCIAL_BASE_URL=https://open.tiktokapis.com
LAYANX_YOUTUBE_PRIVACY_STATUS=private
LAYANX_YOUTUBE_OAUTH_CLIENT_ID=
LAYANX_YOUTUBE_OAUTH_CLIENT_SECRET=
LAYANX_YOUTUBE_OAUTH_REDIRECT_URI=
LAYANX_YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload
LAYANX_LINKEDIN_VERSION=202601
LAYANX_LINKEDIN_SOCIAL_POST_URL=https://api.linkedin.com/rest/posts

# Native media inspection limits / persistence
# Inspection uses HEAD requests; media itself remains hosted at its source URL.

# Binance Spot
# Live execution credentials are stored in the encrypted local secret vault, not in this file.
BINANCE_BASE_URL=https://api.binance.com
BINANCE_LIVE_TRADING_ENABLED=false
BINANCE_MAX_ORDER_NOTIONAL=
