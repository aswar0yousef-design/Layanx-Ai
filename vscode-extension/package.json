{
  "name": "layanx-agent",
  "displayName": "LayanX AI Agent",
  "description": "Use the LayanX local-first agent directly inside Visual Studio Code.",
  "version": "0.4.0",
  "publisher": "layanx",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onCommand:layanx.approvals",
    "onCommand:layanx.autonomous",
    "onCommand:layanx.buildProject",
    "onCommand:layanx.connect",
    "onCommand:layanx.explainSelection",
    "onCommand:layanx.fixSelection",
    "onCommand:layanx.health",
    "onCommand:layanx.linkWorkspace",
    "onCommand:layanx.openAgent",
    "onCommand:layanx.runGoal",
    "onCommand:layanx.setApiToken",
    "onCommand:layanx.startRuntime",
    "onStartupFinished",
    "onView:layanx.agent"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "layanx.openAgent",
        "title": "LayanX: Open Agent"
      },
      {
        "command": "layanx.autonomous",
        "title": "LayanX: Finish a Goal Autonomously"
      },
      {
        "command": "layanx.runGoal",
        "title": "LayanX: Run Goal"
      },
      {
        "command": "layanx.buildProject",
        "title": "LayanX: Build / Repair Project"
      },
      {
        "command": "layanx.explainSelection",
        "title": "LayanX: Explain Selection"
      },
      {
        "command": "layanx.fixSelection",
        "title": "LayanX: Fix Selection"
      },
      {
        "command": "layanx.health",
        "title": "LayanX: Health Check"
      },
      {
        "command": "layanx.startRuntime",
        "title": "LayanX: Start Local Runtime"
      },
      {
        "command": "layanx.setApiToken",
        "title": "LayanX: Set API Token"
      },
      {
        "command": "layanx.connect",
        "title": "LayanX: Connect (Pairing Code)"
      },
      {
        "command": "layanx.approvals",
        "title": "LayanX: Show Approvals"
      },
      {
        "command": "layanx.linkWorkspace",
        "title": "LayanX: Use This Folder as the Project"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "layanx.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "layanx.fixSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "LayanX AI",
      "properties": {
        "layanx.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3000",
          "description": "Local LayanX API base URL."
        },
        "layanx.projectId": {
          "type": "string",
          "default": "",
          "description": "LayanX project ID. Empty uses the current workspace folder name."
        },
        "layanx.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Path to the LayanX-Ai runtime repository. Empty uses the current workspace folder."
        },
        "layanx.runtimeCommand": {
          "type": "string",
          "default": "npm run local",
          "description": "Command used by LayanX: Start Local Runtime (npm run local starts the secure gateway, like LayanX.cmd)."
        },
        "layanx.maxSteps": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 25,
          "description": "Maximum agent steps per request."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "layanx",
          "title": "LayanX",
          "icon": "resources/layanx.svg"
        }
      ]
    },
    "views": {
      "layanx": [
        {
          "id": "layanx.agent",
          "name": "Agent",
          "type": "webview"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aswar0yousef-design/Layanx-Ai"
  }
}
