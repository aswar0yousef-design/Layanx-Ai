{
  "expo": {
    "name": "LayanX Remote",
    "slug": "layanx-remote",
    "version": "0.2.0",
    "orientation": "portrait",
    "android": {
      "package": "com.layanx.remote",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.layanx.remote",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "LayanX connects to your own computer on your home network.",
        "NSCameraUsageDescription": "LayanX uses the camera only to scan the pairing code."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LayanX يستخدم الكاميرا لمسح رمز الربط فقط.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
