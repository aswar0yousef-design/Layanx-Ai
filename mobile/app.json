{
  "expo": {
    "name": "LayanX Remote",
    "slug": "layanx-remote",
    "version": "0.2.0",
    "orientation": "portrait",
    "android": {
      "package": "com.layanx.remote",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.layanx.remote",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "LayanX connects to your own computer on your home network."
      }
    },
    "scheme": "layanx",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LayanX uses the camera only to scan the pairing code shown on your computer.",
          "microphonePermission": "LayanX records a short voice question when you ask it to.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/with-layanx-android"
    ]
  }
}
